COMPOSE_PROJECT_NAME=homologacion-balances
APP_IMAGE_REFERENCE=homologacion-balances:onprem-local
APP_RELEASE_BRANCH=onprem
APP_BUILD_DATE=desarrollo-onprem
MASTER_BUNDLE_VERSION=embedded
PYTHON_BUILD_IMAGE=python:3.12-slim-bookworm
TESSERACT_OCR_VERSION=5.3.0-2
TESSERACT_SPA_VERSION=1:4.1.0-2
POSTGRES_IMAGE=postgres:16-alpine
CADDY_IMAGE=caddy:2.8-alpine
CADDY_INIT_IMAGE=alpine:3.20
ONPREM_DEPLOYMENT_MODE=evaluation
AUTH_ENFORCEMENT=deny
CADDYFILE_PATH=./Caddyfile
BACKUP_ENCRYPTION_REQUIRED=false
BACKUP_RETENTION_DAYS=30
BACKUP_RPO_HOURS=24
BACKUP_RTO_HOURS=8

POSTGRES_DB=homologacion
POSTGRES_USER=homologacion_app

CADDY_HOSTNAME=localhost
HTTP_PORT=80
HTTPS_PORT=443

MAX_UPLOAD_MB=50
QUALITY_CONTROL_ENFORCE_EXPORT=true

# No agregue contrasenas, tokens ni certificados en este archivo.
# La contrasena PostgreSQL se lee desde secrets/postgres_password.txt.
