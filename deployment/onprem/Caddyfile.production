{
	admin off
	auto_https disable_redirects
	http_port 8080
	https_port 8443
}

http://{$CADDY_HOSTNAME:localhost} {
	bind 0.0.0.0
	redir https://{host}{uri} permanent
}

https://{$CADDY_HOSTNAME:localhost} {
	bind 0.0.0.0
	tls internal
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	@health path /_stcore/health
	handle @health {
		reverse_proxy app:8501
	}

	handle {
		request_header -X-Authenticated-User
		request_header -X-Authenticated-Roles
		forward_auth {$AUTH_GATEWAY_URL:http://127.0.0.1:1} {
			uri {$AUTH_GATEWAY_VERIFY_PATH:/verify}
			copy_headers X-Authenticated-User X-Authenticated-Roles
		}
		reverse_proxy app:8501
	}
}
